# Optional app port
PORT=3000

# Demo authentication credentials
DEMO_LOGIN_USERNAME=admin
DEMO_LOGIN_PASSWORD=admin123

# Session signing secret (change in production)
SESSION_SECRET=replace-with-a-strong-random-secret

# Optional Postgres connection string.
# When omitted, the app uses the built-in in-memory demo dataset.
# DATABASE_URL=postgres://stagedock:stagedock-dev-password@localhost:5432/stagedock
